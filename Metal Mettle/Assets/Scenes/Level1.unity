  m_Name: 
  m_EditorClassIdentifier: 
  tutorialSteps:
  - stepID: BloodInfo
    title: Blood System
    description: You need blood to survive. Beat it out of your enemies with left
      mouse button click. Hold for stronger attacks! Beware this drains blood!  Siphon
      dropped blood with the right mouse button.
    triggerType: 5
    requiredAbility: 
    pauseGame: 1
    displayDuration: 0
    dismissInputType: 1
    showOnce: 1
  - stepID: BlockInfo
    title: Blocking
    description: You can block your enemies attacks with left and right mouse button
      hold. Any blocked attacks will chip away blood. Be careful.
    triggerType: 5
    requiredAbility: 
    pauseGame: 1
    displayDuration: 0
    dismissInputType: 1
    showOnce: 1
  - stepID: Pickups
    title: Pickups
    description: This mask piece can be collected. Pick up specific objects in the
      world by using the Execution Key or E key.
    triggerType: 5
    requiredAbility: 
    pauseGame: 1
    displayDuration: 0
    dismissInputType: 1
    showOnce: 1
  - stepID: Execution
    title: Execution
    description: Picking this object up will allow you to gain enough power to perform
      execution moves. Perform these with the E key when enemies are low on health
      and the prompt appears on screen.
    triggerType: 5
    requiredAbility: 
    pauseGame: 1
    displayDuration: 0
    dismissInputType: 1
    showOnce: 1
  - stepID: Destructibles
    title: Destructible Objects
    description: Some objects in the world can be destroyed by attacks. Sometimes
      they open new pathways to your objective.
    triggerType: 5
    requiredAbility: 
    pauseGame: 1
    displayDuration: 0
    dismissInputType: 1
    showOnce: 1
  - stepID: Energy
    title: Energy
    description: Build energy by landing attacks on objects or enemies. Use this
      energy to execute enemies when their health is low. Quick executions cost less
      energy but will alert enemies in the immediate area.
    triggerType: 5
    requiredAbility: 
    pauseGame: 1
    displayDuration: 0
    dismissInputType: 1
    showOnce: 1
  ui:
    tutorialPanel: {fileID: 7264211017294246490}
    titleText: {fileID: 7264211017294246488}
    descriptionText: {fileID: 7264211017294246487}
    dismissText: {fileID: 7264211017294246486}
    backgroundOverlay: {fileID: 7264211017294246491}
    canvasGroup: {fileID: 7264211017294246489}
    fadeSpeed: 2
  tutorialEnabled: 1
  skipCompletedSteps: 1
  bloodSystem: {fileID: 1027897242}
  comboController: {fileID: 1143898616}
  playerController: {fileID: 1143898617}
  executionSystem: {fileID: 1143898622}
